<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootContainer"
    android:orientation="vertical"
    android:background="#101116"
    android:padding="18dp">

    <LinearLayout
        android:id="@+id/brandHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="10dp"
        android:paddingBottom="18dp">
        <TextView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:gravity="center"
            android:text="▶"
            android:textColor="#FFFFFF"
            android:textSize="23sp"
            android:background="@drawable/logo_bg" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FloatTube"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="YouTube, in your own little window"
                android:textColor="#A9ABB7"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/linkLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PASTE A VIDEO LINK"
        android:textColor="#C9CAD3"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:paddingBottom="8dp" />

    <EditText
        android:id="@+id/videoUrlInput"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/input_bg"
        android:hint="https://youtube.com/watch?v=..."
        android:inputType="textUri"
        android:singleLine="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#777986"
        android:selectAllOnFocus="true"
        android:autofillHints="url" />

    <Button
        android:id="@+id/playButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="Load video"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#FF0033" />

    <FrameLayout
        android:id="@+id/playerContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="18dp"
        android:background="@drawable/player_bg">
        <WebView
            android:id="@+id/playerWebView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />
        <TextView
            android:id="@+id/emptyHint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:padding="24dp"
            android:text="Your video will appear here.&#10;&#10;Load a YouTube link, then use the PiP button to try floating mode."
            android:textColor="#A9ABB7"
            android:textSize="14sp" />
    </FrameLayout>

    <Button
        android:id="@+id/pipButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="▣  Enter floating mode"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#292B36" />

    <TextView
        android:id="@+id/policyNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:text="Playback and PiP availability depend on YouTube, the video, and your Android device."
        android:textColor="#777986"
        android:textSize="11sp" />
</LinearLayout>